# Copier ce fichier en .env (jamais commite : voir .gitignore) et le remplir SUR LA MACHINE QUI HEBERGE LE BOT.
# Jamais de jeton dans le depot (REGLES.md, 2.4).

# Jeton du bot (portail developpeur Discord > Bot > Reset Token).
DISCORD_TOKEN=
# Identifiant du serveur Discord KaLium (mode developpeur > clic droit sur le serveur > Copier l'identifiant).
DISCORD_GUILD_ID=

# API de KG_ScoreBoards (Kanvas) par le relais du proxy (KaliumRelay 1.11.0 + KG_ScoreBoards 1.10.0). Facultatif :
# vide = pas de /classement.
RELAIS_URL=http://7018.mystrator.com:46199
# Valeur bot-token de plugins/kaliumrelay/relay.properties sur le proxy (PAS le jeton « token » des serveurs).
RELAIS_TOKEN=

# Ou en direct, si le port de l'API de KG_ScoreBoards est joignable (api.port / api.token de son config.yml). Ignore
# quand RELAIS_URL et RELAIS_TOKEN sont remplis.
API_URL=
API_TOKEN=
